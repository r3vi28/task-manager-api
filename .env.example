# App connection. In production use Neon's POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@localhost:5432/task_manager"

# Optional. Direct (non-pooled) connection used only by Prisma CLI migrations.
# Needed when DATABASE_URL points to a pooler (Neon). Falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://user:password@localhost:5432/task_manager"

# Secret used to sign JWTs. Use a long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET="change-me-to-a-long-random-string"

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins. When unset, all origins are allowed.
CORS_ORIGIN="http://localhost:5173"
